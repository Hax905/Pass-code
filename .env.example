# PassCode environment variables.
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.

# ---------------------------------------------------------------------------
# Phase 0 — Database (required)
# ---------------------------------------------------------------------------
# MongoDB connection string. Either:
#   - MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
#   - Local compose:  mongodb://passcode:<MONGO_ROOT_PASSWORD>@127.0.0.1:27017/?authSource=admin&directConnection=true
# Must point at a replica set (Atlas always is; docker-compose.yml sets one up)
# because later phases use multi-document transactions.
DATABASE_URL=
# Database name inside the cluster (defaults to "passcode").
DATABASE_NAME=passcode

# Only needed when using docker-compose.yml instead of Atlas.
MONGO_ROOT_USERNAME=passcode
MONGO_ROOT_PASSWORD=
MONGO_PORT=27017

# ---------------------------------------------------------------------------
# Phase 1 — Rotation engine
# ---------------------------------------------------------------------------
# 32-byte key, base64-encoded, for encrypting the network password at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it outside the repo; losing it makes stored passwords unrecoverable
# (a fresh rotation fixes that).
PASSCODE_ENCRYPTION_KEY=

# Which RouterAdapter to use. Only "mock" exists: the built-in virtual router.
# PassCode does not support physical routers.
ROUTER_ADAPTER=mock

# "true" runs the rotation scheduler inside the Next.js server. Leave "false"
# on serverless hosts and run `npm run rotation:worker` instead. Either way,
# nothing rotates until rotation settings have been saved (Phase 3 admin UI).
ROTATION_SCHEDULER_ENABLED=false

# Demo/testing only: make the virtual router fail ("always") or fail once and
# succeed on the automatic retry ("first-attempt"). Leave "off" normally.
VIRTUAL_ROUTER_FAILURE=off

# ---------------------------------------------------------------------------
# Phase 2 — Authentication (Auth.js)
# ---------------------------------------------------------------------------
# Generate: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Public base URL of the app.
AUTH_URL=http://localhost:3000
# Optional: password for `npm run user:create-admin` when it can't prompt
# (e.g. in a deploy script). Don't leave it set afterwards.
# PASSCODE_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Phase 4 — Chatbot (server-side only; never expose to the client)
# ---------------------------------------------------------------------------
# Which model backs the assistant: gemini (default) or anthropic.
CHAT_PROVIDER=gemini
# Google AI Studio key, required when CHAT_PROVIDER=gemini.
GEMINI_API_KEY=
# Optional: models tried in order. The free tier answers 503 (high demand) or
# 429 (quota) per model, so the assistant walks the list. List only distinct
# models that still serve: an alias such as gemini-flash-latest shares the
# newest model's quota, and a retired model answers 404 and ends the walk.
# The first entry decides latency, so a lite model leads; the rest are spare
# capacity. Default:
# gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.8-flash
# GEMINI_MODELS=
# Required only when CHAT_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Optional: shown by the assistant when people ask how to connect or whom to contact.
# PASSCODE_NETWORK_NAME=Building-WiFi
# PASSCODE_SUPPORT_CONTACT=the building administrator (office 101, admin@example.com)
